<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      RoadPulse design tokens — colour roles.
      See docs/DESIGN_SYSTEM.md for the documented palette, typography, and spacing scale.
      Screen-chrome tokens (rp_background..rp_border_glow) predate this token pass and are kept
      as-is to avoid a risky rename across existing screens; new work should prefer the semantic
      rp_role_* tokens below, which follow the reference-design colour roles directly.
    -->

    <!-- Screen chrome (existing, in use by MainActivity/SettingsActivity) -->
    <color name="rp_background">#FF090D18</color>
    <color name="rp_panel">#EE0D1322</color>
    <color name="rp_panel_top">#EE121A2E</color>
    <color name="rp_panel_control">#FF172035</color>
    <color name="rp_primary">#FF2B63E0</color>
    <color name="rp_accent">#FF2DD4BF</color>
    <color name="rp_camera_accent">#FFFFB020</color>
    <color name="rp_road_accent">#FF34D399</color>
    <color name="rp_text_muted">#FFE2E9F2</color>
    <color name="rp_border_glow">#462DD4BF</color>

    <!--
      Semantic role tokens (reference-design palette). Forward-declared foundation for the
      upcoming mobile-journey and marker-redesign work — the per-entry UnusedResources
      suppression below reflects that these are intentional, not dead code.
    -->
    <color name="rp_role_map_background" tools:ignore="UnusedResources">#FF0B1220</color>
    <color name="rp_role_route_primary" tools:ignore="UnusedResources">#FF22D3EE</color>
    <color name="rp_role_route_casing" tools:ignore="UnusedResources">#FF0E4C8C</color>
    <color name="rp_role_route_alternative" tools:ignore="UnusedResources">#FF64748B</color>
    <color name="rp_role_text_primary_dark" tools:ignore="UnusedResources">#FFF5F7FA</color>
    <color name="rp_role_text_primary_light" tools:ignore="UnusedResources">#FF1F2937</color>
    <color name="rp_role_success" tools:ignore="UnusedResources">#FF10B981</color>
    <color name="rp_role_caution" tools:ignore="UnusedResources">#FFF59E0B</color>
    <color name="rp_role_critical" tools:ignore="UnusedResources">#FFDC2626</color>
    <color name="rp_role_speed_sign_red" tools:ignore="UnusedResources">#FFE11D2E</color>
    <color name="rp_role_speed_sign_white" tools:ignore="UnusedResources">#FFFFFFFF</color>

    <!-- German road-sign colour family: blue Autobahn signage, yellow general direction signage. -->
    <color name="rp_role_signboard_autobahn_blue">#FF003399</color>
    <color name="rp_role_signboard_direction_yellow">#FFFFCC00</color>
    <color name="rp_role_signboard_lane_recommended">#FF22D3EE</color>
    <color name="rp_role_signboard_lane_muted">#FF64748B</color>
</resources>
