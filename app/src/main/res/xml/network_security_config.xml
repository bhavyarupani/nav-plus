<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits cleartext HTTP only to the loopback address, for LocalMbtilesServer - a self-hosted
  offline tile server that never binds to a non-loopback address (see its class doc). Every other
  destination in the app still requires HTTPS, matching Android's default behavior.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
