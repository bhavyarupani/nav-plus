{
  "version": 8,
  "name": "roadpulse-free-stack-poc",
  "sources": {
    "roadpulse": {
      "type": "vector",
      "tiles": ["http://127.0.0.1:__PORT__/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "bounds": [8.48096, 53.01034, 8.99127, 53.61063],
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0B1220" } },
    {
      "id": "landcover",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "landcover",
      "paint": { "fill-color": "#132015", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "landuse",
      "paint": { "fill-color": "#141C2C", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "park",
      "paint": { "fill-color": "#173420", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "water",
      "paint": { "fill-color": "#0E4C8C" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "waterway",
      "paint": { "line-color": "#0E4C8C", "line-width": 1.2 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#1B2437", "fill-outline-color": "#2A3550" }
    },
    {
      "id": "transportation-minor",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path"], true, false],
      "paint": { "line-color": "#334155", "line-width": 1 }
    },
    {
      "id": "transportation-secondary",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["secondary", "tertiary", "primary"], true, false],
      "paint": { "line-color": "#64748B", "line-width": 2 }
    },
    {
      "id": "transportation-trunk-motorway",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "paint": { "line-color": "#22D3EE", "line-width": 3 }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "boundary",
      "paint": { "line-color": "#475569", "line-width": 1, "line-dasharray": [2, 2] }
    },
    {
      "id": "water-name",
      "type": "symbol",
      "source": "roadpulse",
      "source-layer": "water_name",
      "layout": { "text-field": ["get", "name"], "text-size": 11 },
      "paint": { "text-color": "#7DB8E8" }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "roadpulse",
      "source-layer": "place",
      "layout": { "text-field": ["get", "name"], "text-size": 13 },
      "paint": { "text-color": "#F5F7FA", "text-halo-color": "#0B1220", "text-halo-width": 1.2 }
    }
  ]
}
