{
  "version": 8,
  "name": "roadpulse-day",
  "sources": {
    "roadpulse": {
      "type": "vector",
      "tiles": ["http://127.0.0.1:__PORT__/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#E9EEF1" } },
    {
      "id": "landuse",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "landuse",
      "paint": { "fill-color": "#F3F6F8" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "landcover",
      "paint": { "fill-color": "#E5ECE7", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "park",
      "paint": { "fill-color": "#D5E6D8" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "water",
      "paint": { "fill-color": "#A9D1E1" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "waterway",
      "paint": { "line-color": "#A9D1E1", "line-width": 1.2 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#DCE3E8", "fill-outline-color": "#C5D0D8" }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "boundary",
      "paint": { "line-color": "#B8C6CF", "line-width": 1, "line-dasharray": [2, 2] }
    },
    {
      "id": "transportation-minor",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path"], true, false],
      "paint": { "line-color": "#FFFFFF", "line-width": 1 }
    },
    {
      "id": "transportation-secondary",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["secondary", "tertiary", "primary"], true, false],
      "paint": { "line-color": "#F9FBFC", "line-width": 2 }
    },
    {
      "id": "transportation-trunk-motorway-casing",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "paint": { "line-color": "#6F98B1", "line-width": 4.5 }
    },
    {
      "id": "transportation-trunk-motorway",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "paint": { "line-color": "#9FC4D9", "line-width": 3 }
    }
  ]
}
