{
  "version": 8,
  "name": "roadpulse-night",
  "sources": {
    "roadpulse": {
      "type": "vector",
      "tiles": ["http://127.0.0.1:__PORT__/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "© OpenMapTiles © OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#101B26" } },
    {
      "id": "landuse",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "landuse",
      "paint": { "fill-color": "#141C2C" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "landcover",
      "paint": { "fill-color": "#12211F", "fill-opacity": 0.7 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "park",
      "paint": { "fill-color": "#173025" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "water",
      "paint": { "fill-color": "#07131D" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "waterway",
      "paint": { "line-color": "#07131D", "line-width": 1.2 }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "roadpulse",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#1B2437", "fill-outline-color": "#2A3550" }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "boundary",
      "paint": { "line-color": "#314454", "line-width": 1, "line-dasharray": [2, 2] }
    },
    {
      "id": "transportation-minor",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path"], true, false],
      "paint": { "line-color": "#263A4B", "line-width": 1 }
    },
    {
      "id": "transportation-secondary",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["secondary", "tertiary", "primary"], true, false],
      "paint": { "line-color": "#2D4558", "line-width": 2 }
    },
    {
      "id": "transportation-trunk-motorway-casing",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "paint": { "line-color": "#55B8D0", "line-width": 4.5 }
    },
    {
      "id": "transportation-trunk-motorway",
      "type": "line",
      "source": "roadpulse",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "paint": { "line-color": "#32677F", "line-width": 3 }
    }
  ]
}
