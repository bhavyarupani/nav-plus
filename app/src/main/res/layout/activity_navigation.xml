<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/navigation_fragment"
        android:name="com.google.android.libraries.navigation.SupportNavigationFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/driving_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/lane_guidance_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/roadpulse_lane_panel"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/lane_guidance_image"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/recommended_lanes_content_description"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/lane_guidance_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1.15"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <com.roadpulse.auto.driving.SpeedComplianceRingView
            android:id="@+id/speed_compliance_ring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/speed_compliance_content_description" />

        <LinearLayout
            android:id="@+id/road_ahead_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/roadpulse_driving_panel"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/road_ahead_eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="@string/road_ahead_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="#2DD4BF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/road_ahead_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/road_ahead_meta_default"
                    android:textColor="#34D399"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/road_ahead_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/road_ahead_primary_default"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/road_ahead_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#C8D7E3"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="#22314A" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/navigation_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B8C7D3"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/stop_navigation"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#1B2A44"
                    android:minWidth="72dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/stop_navigation_button"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
